# Settings for docker-compose.stack.yml. Copy to `.env` (git-ignored) and fill in.
# Never commit real values. Generate each secret with: openssl rand -hex 32
# (or in PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) }))

# --- ConnectWise Manage (use a test tenant or a read-only API member) ---
CW_MANAGE_COMPANY_ID=
CW_MANAGE_PUBLIC_KEY=
CW_MANAGE_PRIVATE_KEY=
CW_MANAGE_CLIENT_ID=
CW_MANAGE_URL=https://api-na.myconnectwise.net

# --- Whose ConnectWise key the server uses (see cw-per-user-keys.md) ---
# shared   = the CW_MANAGE_PUBLIC_KEY / CW_MANAGE_PRIVATE_KEY above, for everybody (default).
# per-user = each person's own CW API key from CW_USER_KEYS. The shared keys above
#            are not used (leave them empty). A person with no key is refused: there
#            is no fallback to the shared key. Any other value stops the server.
CW_CREDENTIALS=shared
# name=publicKey:privateKey, separated by ";". The name is the person's Entra
# sign-in name (Entra mode) or their PROXY_USERS name (token mode), matched without
# regard to case. No spaces, ":" ";" or "=" inside a key.
# Example: CW_USER_KEYS=nick@tektrendz.com=<public key>:<private key>;sam@tektrendz.com=<public key>:<private key>
# These keys are readable by anyone who can run `docker inspect` on this machine.
CW_USER_KEYS=

# --- Secrets for this stack ---
# Shared by the MCP server and the signing proxy. Not a CW value.
CONDUIT_S2S_SECRET=
# One entry per person: name:token[:role], separated by ";". Each person gets
# their own token (32+ characters, no ":" or spaces) and sends it as
# "Authorization: Bearer <token>". The name goes into the audit log. role is
# read, write or admin and overrides MCP_POLICY for that person (optional).
# Example (generate each token with openssl rand -hex 32):
#   PROXY_USERS=alice:<token>:write;bob:<token>
PROXY_USERS=
# Older single shared token for everybody (logged as "shared-token"). Leave empty
# when PROXY_USERS is set.
PROXY_BEARER_TOKEN=

# Default access level for people without a role: read | write | admin.
#   read   = get/search/list tools only (default)
#   write  = adds create/update/add tools
#   admin  = adds delete tools
# Writes are off until you raise this or give a person a role.
MCP_POLICY=read

# Write policy (optional). With write access on (MCP_POLICY=write or a CWM.Write
# role), this narrows WHAT may be written: a JSON file listing the write tools
# allowed and the argument values each may use. Tools not listed are refused.
# Copy deploy/write-policy/write-policy.example.json to
# deploy/write-policy/write-policy.json, edit the ids, then set:
#   MCP_WRITE_POLICY_FILE=/etc/cw-mcp/write-policy.json
# Leave empty to turn it off. A bad file stops the server. See README, "Write policy".
MCP_WRITE_POLICY_FILE=

# --- Microsoft Entra sign-in (optional). Steps: entra-setup-portal-steps.md ---
# To use Entra instead of PROXY_USERS: PROXY_AUTH=entra, MCP_OAUTH_ENABLED=true
# and the values below. Roles (CWM.Access / CWM.Write / CWM.Admin) set access.
PROXY_AUTH=tokens
MCP_OAUTH_ENABLED=false
# Public https address people connect to, no trailing slash.
MCP_SERVER_URL=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_AUDIENCE=
AZURE_REQUIRED_ROLE=CWM.Access

# --- HTTPS (optional): docker compose --profile https ... ---
# Caddy gets its certificate by the Cloudflare DNS challenge (no inbound port
# needed for the certificate). CF_API_TOKEN needs Zone:Read and DNS:Edit on one zone.
MCP_HOSTNAME=
CF_API_TOKEN=
# 127.0.0.1 = this machine only. 0.0.0.0 = reachable from other machines on 443.
HTTPS_BIND=127.0.0.1

# HMAC key for the PII tokens. 16+ characters. Changing it changes every token.
PII_KEY=

# --- Network ---
# 127.0.0.1 = this machine only. 0.0.0.0 = reachable from other machines (plain HTTP).
PROXY_BIND=127.0.0.1
PROXY_PORT=8081

# LOG_LEVEL=info
# PII_PRESIDIO_TIMEOUT_MS=5000

# --- IT Glue MCP (optional): docker compose --profile itglue ... ---
# Clone NNewnhamTT/itglue-mcp (branch tektrendz-hardening) next to this repo,
# or point ITGLUE_REPO_PATH at it. Password tools are removed in that fork.
# ITGLUE_REPO_PATH=../itglue-mcp
# Separate S2S secret for the IT Glue proxy and server: openssl rand -hex 32
ITGLUE_S2S_SECRET=
# Shared IT Glue API key (read-only key recommended). Secret.
ITGLUE_API_KEY=
ITGLUE_REGION=us
# tokens: name:token[:role];... as PROXY_USERS above (use different tokens).
ITGLUE_PROXY_AUTH=tokens
ITGLUE_PROXY_USERS=
ITGLUE_PROXY_PORT=8082
ITGLUE_MCP_POLICY=read
# Entra sign-in for IT Glue: its own app registration, roles ITG.Access,
# ITG.Write, ITG.Admin. AZURE_TENANT_ID above is shared.
ITGLUE_MCP_OAUTH_ENABLED=false
ITGLUE_MCP_SERVER_URL=
ITGLUE_AZURE_CLIENT_ID=
ITGLUE_AZURE_AUDIENCE=
ITGLUE_AZURE_REQUIRED_ROLE=ITG.Access
# HTTPS for IT Glue: a second host name, plus CADDY_CONFIG=Caddyfile.itglue
# and both profiles (--profile https --profile itglue).
ITGLUE_HOSTNAME=
# CADDY_CONFIG=Caddyfile
